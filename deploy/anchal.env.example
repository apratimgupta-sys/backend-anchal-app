# Replace every placeholder through the deployment platform's secret store.
# Do not copy real credentials, tokens, or connection strings into this file.
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__CommissionerMonitoring=Host=<database-host>;Port=5432;Database=<database-name>;Username=<database-user>;Password=<secret>;SSL Mode=VerifyFull
CommissionerMonitoring__DatabaseEnvironment=Production
CommissionerMonitoring__ExpectedHost=<database-host>
CommissionerMonitoring__ExpectedPort=5432
CommissionerMonitoring__ExpectedDatabase=<database-name>
CommissionerMonitoring__ExpectedUsername=<database-user>
Anchal__Jwt__Secret=<secret-at-least-32-bytes>
Anchal__Jwt__Issuer=<issuer>
Anchal__Jwt__Audience=<audience>
Anchal__Jwt__ExpiryMinutes=60
CommissionerMonitoring__RoutesEnabled=true
Cors__AllowedOrigins__0=https://<frontend-host>
